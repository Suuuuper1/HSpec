+    def compute_spec_decode_metrics(self) -> dict:
+        if self.node_rank != 0:
+            return {}
+        if not hasattr(self, 'engine'):
+            return {}
+        try:
+            logger_manager = getattr(self.engine, 'logger_manager', None)
+            if logger_manager is None:
+                return {}
+            stat_loggers = getattr(logger_manager, 'stat_loggers', None)
+            if not stat_loggers:
+                return {}
+
+            prom_logger = next(
+                (l for l in stat_loggers if isinstance(l, PrometheusStatLogger)),
+                None
+            )
+            if prom_logger is None:
+                return {}
+
+            spec_prom = getattr(prom_logger, 'spec_decoding_prom', None)
+            if spec_prom is None or not spec_prom.spec_decoding_enabled:
+                return {}
+
+            # Read cumulative counters
+            cum_drafts = prom_logger.spec_decoding_prom.counter_spec_decode_num_drafts[0]._value.get()
+            cum_draft_tokens = prom_logger.spec_decoding_prom.counter_spec_decode_num_draft_tokens[0]._value.get()
+            cum_accepted_tokens = prom_logger.spec_decoding_prom.counter_spec_decode_num_accepted_tokens[0]._value.get()
+
+            # Compute per-step deltas
+            drafts = cum_drafts - self._prev_spec_stats['num_drafts']
+            draft_tokens = cum_draft_tokens - self._prev_spec_stats['num_draft_tokens']
+            accepted_tokens = cum_accepted_tokens - self._prev_spec_stats['num_accepted_tokens']
+
+            # Update previous values
+            self._prev_spec_stats['num_drafts'] = cum_drafts
+            self._prev_spec_stats['num_draft_tokens'] = cum_draft_tokens
+            self._prev_spec_stats['num_accepted_tokens'] = cum_accepted_tokens
+
+            if draft_tokens == 0 or drafts == 0:
+                return {}
+
+            result = {
+                "spec_decode/draft_acceptance_rate":  float(accepted_tokens / draft_tokens),
+                "spec_decode/mean_acceptance_length": float(1.0 + accepted_tokens / drafts),
+                "spec_decode/num_drafts":             float(drafts),
+                "spec_decode/num_accepted_tokens":    float(accepted_tokens),
+                "spec_decode/num_draft_tokens":       float(draft_tokens),
+            }
+
+            # Per-position acceptance stats
+            per_pos_dict = getattr(
+                prom_logger.spec_decoding_prom,
+                'counter_spec_decode_num_accepted_tokens_per_pos',
+                None
+            )
+
+            if per_pos_dict is not None:
+                prev_per_pos = self._prev_spec_stats['num_accepted_tokens_per_pos']
+
+                # per_pos_dict is {engine_idx: [counter_pos0, counter_pos1, ...]}
+                per_pos_counters = per_pos_dict[0]  # engine_idx=0
+                cum_per_pos = [c._value.get() for c in per_pos_counters]
+
+                if prev_per_pos is None:
+                    prev_per_pos = [0] * len(cum_per_pos)
+
+                per_pos_delta = [cum_per_pos[i] - prev_per_pos[i] for i in range(len(cum_per_pos))]
+                self._prev_spec_stats['num_accepted_tokens_per_pos'] = cum_per_pos
+
+                for i, count in enumerate(per_pos_delta):
+                    result[f"spec_decode/accepted_tokens_pos_{i}"] = float(count)
+                if drafts > 0:
+                    for i, count in enumerate(per_pos_delta):
+                        result[f"spec_decode/acceptance_rate_pos_{i}"] = float(count / drafts)
+            return result
+        except Exception as e:
+            logger.warning(f"Could not get spec decode stats: {e}")
+            return {}

