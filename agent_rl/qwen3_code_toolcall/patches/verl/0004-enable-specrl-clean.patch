+    def _collect_spec_decode_stats(self) -> dict:
+        """Collect spec decode stats from all server replicas, return per-step delta stats."""
+        try:
+            if not hasattr(self, 'server_handles') or not self.server_handles:
+                return {}
+
+            stats_list = ray.get([
+                server.compute_spec_decode_metrics.remote()
+                for server in self.server_handles
+            ])
+
+            # Only node_rank=0 servers return non-empty stats
+            # Average rates across replicas, sum counts
+            non_empty = [s for s in stats_list if s]
+            if not non_empty:
+                return {}
+            # If single replica just return it directly
+            if len(non_empty) == 1:
+                return non_empty[0]
+            # Multiple replicas: sum counts, recompute rates
+            result = {}
+            total_drafts = sum(s.get("spec_decode/num_drafts", 0) for s in non_empty)
+            total_draft_tokens = sum(s.get("spec_decode/num_draft_tokens", 0) for s in non_empty)
+            total_accepted = sum(s.get("spec_decode/num_accepted_tokens", 0) for s in non_empty)
+
+            result["spec_decode/num_drafts"] = total_drafts
+            result["spec_decode/num_draft_tokens"] = total_draft_tokens
+            result["spec_decode/num_accepted_tokens"] = total_accepted
+            result["spec_decode/draft_acceptance_rate"] = total_accepted / total_draft_tokens if total_draft_tokens > 0 else 0.0
+            result["spec_decode/mean_acceptance_length"] = 1.0 + total_accepted / total_drafts if total_drafts > 0 else 1.0
+
+            # Per-position stats
+            num_pos = len([k for k in non_empty[0] if k.startswith("spec_decode/accepted_tokens_pos_")])
+            for i in range(num_pos):
+                key_count = f"spec_decode/accepted_tokens_pos_{i}"
+                key_rate = f"spec_decode/acceptance_rate_pos_{i}"
+                total_pos = sum(s.get(key_count, 0) for s in non_empty)
+                result[key_count] = total_pos
+                result[key_rate] = total_pos / total_drafts if total_drafts > 0 else 0.0
+            return result
+        except Exception as e:
+            logger.warning(f"Could not collect spec decode stats: {e}")
+            return {}
+
