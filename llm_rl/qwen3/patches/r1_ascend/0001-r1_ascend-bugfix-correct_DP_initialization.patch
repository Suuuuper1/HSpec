 recipe/r1_ascend/vllm_parallel_state.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/llm_rl/qwen3/r1_ascend/vllm_parallel_state.py b/llm_rl/qwen3/r1_ascend/vllm_parallel_state.py
index 82eb4175..9bfe08e7 100644
